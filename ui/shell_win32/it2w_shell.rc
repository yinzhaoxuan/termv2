#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "it2w_shell.manifest"

IDD_CONNECTION DIALOGEX 0, 0, 520, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "连接"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "名称", -1, 10, 12, 44, 12
    EDITTEXT IDC_NAME, 60, 10, 448, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "分组", -1, 10, 34, 44, 12
    COMBOBOX IDC_GROUP, 60, 32, 448, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "外观", -1, 10, 56, 44, 12
    COMBOBOX IDC_APPEARANCE, 60, 54, 448, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "类型", -1, 10, 78, 44, 12
    COMBOBOX IDC_KIND, 60, 76, 448, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "SSH", IDC_SSH_BOX, 8, 98, 502, 174
    LTEXT "主机", IDC_HOST_LABEL, 16, 116, 40, 12
    EDITTEXT IDC_HOST, 60, 114, 260, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "虚拟机 ID", IDC_VM_LABEL, 16, 116, 44, 12
    EDITTEXT IDC_VM, 60, 114, 220, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "选择…", IDC_VM_SELECT, 284, 113, 58, 16, WS_TABSTOP
    LTEXT "端口", IDC_PORT_LABEL, 354, 116, 30, 12
    EDITTEXT IDC_PORT, 388, 114, 110, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "网卡", IDC_ADAPTER_LABEL, 16, 138, 40, 12
    COMBOBOX IDC_ADAPTER, 60, 136, 220, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "回退地址", IDC_FALLBACK_LABEL, 290, 138, 52, 12
    EDITTEXT IDC_FALLBACK, 346, 136, 152, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "用户名", IDC_USER_LABEL, 16, 160, 40, 12
    EDITTEXT IDC_USER, 60, 158, 438, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "认证", IDC_AUTH_LABEL, 16, 182, 40, 12
    COMBOBOX IDC_AUTH, 60, 180, 438, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "密钥文件", IDC_KEY_LABEL, 16, 204, 44, 12
    EDITTEXT IDC_KEY, 60, 202, 372, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_KEY_BROWSE, 440, 201, 58, 16, WS_TABSTOP
    LTEXT "传输", IDC_TRANSPORT_LABEL, 16, 226, 40, 12
    COMBOBOX IDC_TRANSPORT, 60, 224, 438, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "连接超时", IDC_TIMEOUT_LABEL, 16, 248, 44, 12
    EDITTEXT IDC_TIMEOUT, 60, 246, 60, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "秒", IDC_TIMEOUT_UNIT, 126, 248, 20, 12
    GROUPBOX "本地程序", IDC_LOCAL_BOX, 8, 98, 502, 174
    LTEXT "程序", IDC_EXECUTABLE_LABEL, 16, 116, 40, 12
    EDITTEXT IDC_EXECUTABLE, 60, 114, 372, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "浏览…", IDC_EXECUTABLE_BROWSE, 440, 113, 58, 16, WS_TABSTOP
    LTEXT "参数", IDC_ARGUMENTS_LABEL, 16, 140, 40, 12
    EDITTEXT IDC_ARGUMENTS, 60, 138, 438, 62, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT "每行一个参数", IDC_ARGUMENTS_NOTE, 60, 204, 438, 12
    LTEXT "工作目录", IDC_DIRECTORY_LABEL, 16, 226, 44, 12
    EDITTEXT IDC_DIRECTORY, 60, 224, 438, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "留空 = 用户主目录", IDC_DIRECTORY_NOTE, 60, 241, 438, 12
    LTEXT "环境变量请在 connections.json 中编辑（本编辑器保留原值）", IDC_ENVIRONMENT_NOTE, 16, 257, 482, 12
    LTEXT "", IDC_ERROR, 10, 278, 498, 12, SS_LEFTNOWORDWRAP | SS_NOPREFIX
    DEFPUSHBUTTON "确定", IDOK, 378, 304, 62, 18, WS_TABSTOP
    PUSHBUTTON "取消", IDCANCEL, 446, 304, 62, 18, WS_TABSTOP
END

IDD_TEXT_PROMPT DIALOGEX 0, 0, 330, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "分组"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "分组名称", IDC_PROMPT_LABEL, 10, 12, 310, 26, SS_NOPREFIX
    EDITTEXT IDC_PROMPT_TEXT, 10, 40, 310, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 190, 72, 62, 18, WS_TABSTOP
    PUSHBUTTON "取消", IDCANCEL, 258, 72, 62, 18, WS_TABSTOP
END
